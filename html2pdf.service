[Unit]
Description=Puppeteer HTML2PDF Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
WorkingDirectory=@INSTALL_DIR@
ExecStart=/usr/bin/node @INSTALL_DIR@/server.js
EnvironmentFile=@CONFIG_DIR@/environment

Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

# Server has 64 GB RAM; preserve capacity for the OS and other services.
MemoryHigh=48G
MemoryMax=56G
TasksMax=4096
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
