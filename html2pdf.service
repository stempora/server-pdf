[Unit]
Description=Puppeteer HTML2PDF Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pdf
Group=pdf
WorkingDirectory=/home/pdf/server
ExecStart=/usr/bin/node /home/pdf/server/server.js
EnvironmentFile=/home/pdf/server/environment

Restart=always
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

# Server has 64 GB RAM; preserve capacity for the OS and other services.
MemoryHigh=48G
MemoryMax=56G
TasksMax=4096
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
